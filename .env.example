# Copy to .env (gitignored) and fill in. Never commit .env; never paste its values into chat.
# daily_crew.ps1 masks every value in .env (except HQ_* settings) in its logs.

# --- HQ settings (non-secret; read by hq/config.py; only HQ_* keys are ever read by Python)
HQ_PROJECT_NAME=My Project
# Dashboard plugins, comma-separated. "ledger" = the money panel. Empty = none.
HQ_PLUGINS=ledger
# CRITIC's pass bar; `hq.report submit --score` refuses anything lower.
HQ_PASS_SCORE=9
# Monthly profit goal in cents for the ledger plugin's goal bars (0 = no goal bar). 20000 = $200.
HQ_GOAL_CENTS=0

# --- Your project's secrets (examples; names only in docs, values only here)
# SERVICE_API_TOKEN=
# Do NOT set ANTHROPIC_API_KEY for the crew: the daily shift runs on your Claude subscription
# and removes that variable so it can never bill the API.
